{
  "name": "@acl/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted backend logic: ingestion, reconciliation, replay, addon-update snapshots. Bound to Postgres by Edge Functions; tested against an in-memory store.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/serve.ts --bundle --platform=node --format=esm --target=node20 --external:pg --outfile=dist/serve.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pg": "vitest run test/pg.test.ts",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "dev": "tsx src/serve.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@acl/contracts": "workspace:*",
    "@acl/rating": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "@types/pg": "8.11.10",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
