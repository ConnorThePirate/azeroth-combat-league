# Azeroth Combat League — environment template (no real values here)

# --- server (packages/server) ------------------------------------------------

# Postgres connection string. When set, the API uses the PG bindings and
# never seeds. When unset, the in-memory dev store is used.
DATABASE_URL=

# "disable" for a local Postgres without TLS; leave unset for Supabase
# (the pooler requires TLS; the driver uses rejectUnauthorized:false).
PGSSL=

# Port the API listens on. Default: 8787
ACL_PORT=8787

# Season UUID the API serves ratings/status for.
ACL_SEASON=00000000-0000-4000-8000-0000000000aa

# "0" disables the deterministic dev seed (memory mode only; PG never seeds).
ACL_SEED=1

# Base URL the companion uses for pairing links, e.g. https://site.example/pair
ACL_VERIFY_URL=http://localhost:5173/account/pair

# "1" enables POST /v1/session — a development account-id login that lets any
# caller impersonate any account. Never enable against production data.
# Defaults on only for the seeded in-memory dev server.
ACL_DEV_LOGIN=

# Comma-separated account ids allowed on /v1/admin/* (e.g. regeneration).
# Empty/unset means nobody is admin.
ACL_ADMIN_ACCOUNTS=

# Comma-separated allowed web origins for CORS. Unset = "*" (dev only).
ACL_WEB_ORIGIN=https://your-site.example

# "1" trusts X-Forwarded-For for rate limiting — set only behind a proxy
# that sets it (e.g. Fly.io, nginx). Otherwise the socket address is used.
ACL_TRUST_PROXY=

# --- web (apps/web) ----------------------------------------------------------

# Base URL of the API the site talks to. Unset = fixture/demo data.
VITE_API_URL=http://localhost:8787

# Directory the companion watches for addon outbox files (uploader dev only).
ACL_COMPANION_DIR=
