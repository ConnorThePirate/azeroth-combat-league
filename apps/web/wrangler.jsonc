// Cloudflare Workers static-assets deploy for the web app.
// Committing this file opts out of wrangler's automatic configuration
// (which runs npm and can't handle pnpm's workspace:* protocol).
// Build output (vite -> dist/) is deployed as Worker static assets;
// _headers/_redirects in public/ land in dist and are honored.
// `name` must match the Workers Builds project name in the dashboard.
{
  "name": "azeroth-combat-league",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
