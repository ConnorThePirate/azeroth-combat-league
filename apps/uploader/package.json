{
  "name": "@acl/uploader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only companion: watches the addon SavedVariables file and uploads complete reports.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@acl/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
